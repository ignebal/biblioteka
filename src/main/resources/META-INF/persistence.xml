<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="BibliotekaDS" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/BibliotekaDS</jta-data-source>

        <class>lt.vu.entities.Autorius</class>
        <class>lt.vu.entities.Knyga</class>
        <class>lt.vu.entities.Skaitytojas</class>

        <properties>
            <!-- Automatiškai sukuria/atnaujina lenteles pagal esybes -->
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="drop-and-create"/>
            <!-- Rodo SQL žurnaluose -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>